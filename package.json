{
  "name": "aurora-launcher",
  "version": "0.2.1",
  "description": "Aurora — Minecraft launcher and private modpack hub",
  "main": "src/main.js",
  "author": "Aurora",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "games.aurora.launcher",
    "productName": "Aurora",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Aurora-${version}-Windows-x64.exe",
      "icon": "src/ui/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "extraResources": [
      {
        "from": "launcher.config.json",
        "to": "launcher.config.json"
      }
    ]
  }
}