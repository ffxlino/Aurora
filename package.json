{
  "name": "aurora-launcher",
  "version": "0.14.3",
  "description": "Aurora — Minecraft launcher and private modpack hub",
  "main": "src/main.js",
  "author": {
    "name": "Fish Fox Lino",
    "email": "ffxlino@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage pacman --x64",
    "verify:engine": "node scripts/verify-engine.cjs",
    "content:build": "node scripts/prepare-content.cjs",
    "predist": "npm run content:build",
    "predist:linux": "npm run content:build",
    "release:key": "node scripts/release-key.cjs",
    "release:sign": "node scripts/sign-update.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.3",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "games.aurora.launcher",
    "productName": "Aurora",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "SBOM.cdx.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Aurora-${version}-Windows-x64.exe",
      "icon": "src/ui/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "extraResources": [
      {
        "from": "launcher.config.json",
        "to": "launcher.config.json"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Game",
      "icon": "src/ui/icon.png",
      "artifactName": "Aurora-${version}-Linux-${arch}.${ext}",
      "executableName": "aurora",
      "desktop": {
        "entry": {
          "Name": "Aurora",
          "Comment": "Minecraft modpack manager",
          "Categories": "Game;"
        }
      }
    },
    "pacman": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "alsa-lib",
        "mesa"
      ]
    },
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Fish Fox Lino and Aurora contributors"
  },
  "homepage": "https://ffxlino.github.io/Aurora/",
  "overrides": {
    "global-agent": "4.1.3"
  }
}
